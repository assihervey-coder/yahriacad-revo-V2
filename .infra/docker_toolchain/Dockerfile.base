# syntax=docker/dockerfile:1.7
# =============================================================================
# Image de base reproductible [Circuitron] — pcb_ai_designer_v2
# -----------------------------------------------------------------------------
# Contient la chaîne d'outils EDA :
#   python 3.11 (deadsnakes) + KiCad 8.0 (ppa) + SKiDL 1.2.1
#   + FreeRouting 2.6.1 (jar) + numpy 1.26.4 — versions miroir de versions.lock.
#
# Base : ubuntu:22.04 (jammy). CONTRAINTE STRUCTURELLE : ppa:kicad/kicad-8.0-releases
# ne publie des paquets QUE pour Ubuntu (jammy/noble) — une base Debian
# (slim-bookworm) ne peut jamais résoudre kicad=8.0.*. Python 3.11 vient du
# ppa:deadsnakes ; l'épinglage exact de la chaîne est assuré par le DIGEST de
# l'image publiée (docker push puis pcb-base@sha256:<digest>), cf. versions.lock.
#
# Build :
#   docker build -f .infra/docker_toolchain/Dockerfile.base \
#     -t pcb-base:2.0.0 .infra/docker_toolchain/
# =============================================================================

FROM ubuntu:22.04 AS pcb-base

# --- versions gelées (source de vérité : .infra/docker_toolchain/versions.lock)
ARG SKIDL_VERSION=1.2.1
ARG NUMPY_VERSION=1.26.4
ARG FREEROUTING_VERSION=2.6.1
# Digest du jar FreeRouting à figer après vérification sur la page de release
# upstream (github.com/freerouting/freerouting/releases) — politique : on NE
# TELECHARGE QUE depuis un tag précis, jamais "latest".
ARG FREEROUTING_RELEASE_URL=https://github.com/freerouting/freerouting/releases/download/v${FREEROUTING_VERSION}/freerouting-${FREEROUTING_VERSION}.jar

ENV DEBIAN_FRONTEND=noninteractive \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    LANG=C.UTF-8

# --- dépendances système + python 3.11 (deadsnakes) + dépôt KiCad 8 -----------
# kicad-packages3d est volontairement omis (~1 Go) : les services de la
# plateforme (parse netlist, ERC, export Gerber via kicad-cli) n'utilisent pas
# les modèles 3D ; l'ajouter si besoin :
#   && apt-get install -y --no-install-recommends kicad-packages3d="8.0.*"
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates curl gpg-agent software-properties-common gnupg \
        build-essential git \
    && add-apt-repository --yes ppa:deadsnakes/ppa \
    && add-apt-repository --yes ppa:kicad/kicad-8.0-releases \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        python3.11 python3.11-venv python3.11-dev \
        "kicad=8.0.*" \
    && python3.11 -m ensurepip --upgrade \
    && ln -sf /usr/bin/python3.11 /usr/local/bin/python3 \
    && ln -sf /usr/local/bin/python3 /usr/local/bin/python \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# --- socle Python gelé --------------------------------------------------------
# Politique de hachage : en production, remplacer ces pip install par la
# version à hashes générée par pip-tools :
#   pip-compile --generate-hashes requirements/base.in
#   pip install --require-hashes -r requirements/base.txt
# (bloc volontairement commenté : les hashes se régénèrent à chaque bump de
#  versions.lock, on les maintient dans requirements/base.txt)
RUN python -m pip install --no-cache-dir \
        "numpy==${NUMPY_VERSION}" \
        "skidl==${SKIDL_VERSION}"

# --- FreeRouting 2.6.1 (jar Java) --------------------------------------------
# Utilisé comme moteur de routage externe optionnel dans la chaîne déterministe
# (appelle via CLI : java -jar /opt/freerouting/freerouting.jar ...).
# Le jar est téléchargé depuis le tag exact v2.6.1 et son digest SHA-256 est
# enregistré dans /opt/freerouting/SHA256SUMS : toute reproduction de l'image
# doit retrouver EXACTEMENT ce digest (sinon le build échoue en prod, où l'ARG
# FREEROUTING_SHA256 attendu est fourni par le pipeline de release).
ARG FREEROUTING_SHA256=pin-after-verification
RUN mkdir -p /opt/freerouting \
    && curl -fsSL -o /opt/freerouting/freerouting.jar "${FREEROUTING_RELEASE_URL}" \
    && cd /opt/freerouting \
    && sha256sum freerouting.jar | tee SHA256SUMS \
    && if [ "${FREEROUTING_SHA256}" != "pin-after-verification" ]; then \
           echo "${FREEROUTING_SHA256}  freerouting.jar" | sha256sum -c -; fi

# --- JRE pour FreeRouting (headless, version fixée) --------------------------
RUN apt-get update \
    && apt-get install -y --no-install-recommends openjdk-17-jre-headless \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# --- CUDA 12.4 runtime (OPTIONNEL) --------------------------------------------
# Les services d'inférence (ai_engine/rl_agent, simulator) tournent sur les
# nœuds GPU Kubernetes avec le driver NVIDIA >= 550 (CUDA 12.4). Pour une
# variante GPU de cette image de base, remplacer le FROM par :
#
# FROM nvidia/cuda:12.4.1-runtime-ubuntu22.04 AS pcb-base-cuda
# ENV DEBIAN_FRONTEND=noninteractive
# RUN apt-get update && apt-get install -y --no-install-recommends \
#         software-properties-common ca-certificates curl gpg-agent gnupg \
#     && add-apt-repository --yes ppa:deadsnakes/ppa \
#     && add-apt-repository --yes ppa:kicad/kicad-8.0-releases \
#     && apt-get update && apt-get install -y --no-install-recommends \
#         python3.11 python3.11-venv kicad="8.0.*" \
#     && python3.11 -m ensurepip --upgrade \
#     && ln -sf /usr/bin/python3.11 /usr/local/bin/python3 \
#     && ln -sf /usr/local/bin/python3 /usr/local/bin/python \
#     && rm -rf /var/lib/apt/lists/*
# # pip : numpy 1.26.4 + cupy-cuda12x (bindings CUDA optionnels de requirements.txt)
# RUN python -m pip install --no-cache-dir numpy==1.26.4 cupy-cuda12x==13.1 skidl==1.2.1
#
# Les deux variantes publient des digests distincts :
#   pcb-base:2.0.0-cpu  et  pcb-base:2.0.0-cuda12.4

# --- métadonnées OCI ----------------------------------------------------------
LABEL org.opencontainers.image.title="pcb-ai-designer base toolchain" \
      org.opencontainers.image.description="KiCad 8 + SKiDL 1.2.1 + FreeRouting 2.6.1 + Python 3.11 (ubuntu 22.04, gelés — reproductibilité Circuitron)" \
      org.opencontainers.image.version="2.0.0" \
      org.opencontainers.image.base.name="ubuntu:22.04" \
      org.opencontainers.image.source="https://git.example.com/pcb/pcb_ai_designer_v2"

# Vérification de la chaîne au démarrage du conteneur (make verify-toolchain).
RUN python --version && kicad-cli version 2>/dev/null || kicad --version || true
CMD ["/bin/bash"]
