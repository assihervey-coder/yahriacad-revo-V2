# pcb_ai_designer_v2 — variables d'environnement (copier vers .env)

# --- identité / logs ---
APP_ENV=development
LOG_LEVEL=INFO
SERVICE_NAME=pcb-service

# --- réseau gRPC ---
GRPC_HOST=0.0.0.0
GRPC_PORT=50051
GATEWAY_PORT=8000

# --- persistance (section 07) ---
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=pcb-projects
S3_ACCESS_KEY=pcbadmin
S3_SECRET_KEY=pcb-dev-secret
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=pcb-dev
REDIS_URL=redis://localhost:6379/0
POSTGRES_DSN=postgresql://pcb:pcb-dev@localhost:5432/pcb_designer

# --- LLM / RAG (briques Siemens Fuse + Circuitron) ---
# LLM_PROVIDER : local (extractif déterministe) | ollama (LLM local natif)
#              | openai-compatible (toute API /v1/chat/completions)
LLM_PROVIDER=ollama
LLM_MODEL=llama3.1:8b
LLM_API_BASE=http://localhost:11434/v1
LLM_API_KEY=
EMBEDDING_MODEL=bge-m3
VECTOR_STORE_DIR=data/trained_models/vector_store

# --- Ollama local (API native /api) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TIMEOUT_S=8.0
OLLAMA_NUM_CTX=4096

# --- simulateur C++/CUDA ---
ENABLE_CUDA=false

# --- latences cibles (section 11) ---
WS_TARGET_LATENCY_MS=100
BUS_TARGET_LATENCY_MS=50
FAST_EVAL_BUDGET_S=5.0

# --- crédits (brique DeepPCB) ---
CREDITS_LEDGER_PATH=data/projects/credits.json

# --- sécurité gateway ---
JWT_SECRET=change-me-in-production
JWT_EXPIRES_MIN=120
API_RATE_LIMIT_DEFAULT=60/minute
