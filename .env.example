# pcb_ai_designer_v2 — variables d'environnement (copier vers .env)

# --- identité / logs ---
APP_ENV=development
LOG_LEVEL=INFO
SERVICE_NAME=pcb-service

# --- réseau gRPC ---
GRPC_HOST=0.0.0.0
GRPC_PORT=50051
GATEWAY_PORT=8000

# --- persistance (section 07) ---
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=pcb-projects
S3_ACCESS_KEY=pcbadmin
S3_SECRET_KEY=pcb-dev-secret
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=pcb-dev
REDIS_URL=redis://localhost:6379/0
POSTGRES_DSN=postgresql://pcb:pcb-dev@localhost:5432/pcb_designer

# --- LLM / RAG (briques Siemens Fuse + Circuitron) ---
# LLM_PROVIDER : local (extractif déterministe) | ollama (LLM local natif)
#              | openai-compatible (toute API /v1/chat/completions)
LLM_PROVIDER=ollama
# qwen2.5-coder:14b — modèle codeur 14B (~9 Go en q4_K_M), tiré par
# `make ollama-pull` / scripts/ollama_setup.sh ; GPU recommandé (>= 12 Go VRAM).
LLM_MODEL=qwen2.5-coder:14b
LLM_API_BASE=http://localhost:11434/v1
LLM_API_KEY=
EMBEDDING_MODEL=bge-m3
VECTOR_STORE_DIR=data/trained_models/vector_store

# --- Ollama local (API native /api) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TIMEOUT_S=8.0
OLLAMA_NUM_CTX=4096
# Modèle téléchargé par `make ollama-pull` et scripts/ollama_setup.sh
OLLAMA_MODEL=qwen2.5-coder:14b

# --- passe RL / boucle nocturne ---
# Slot runtime du world model : écrit par la passe RL (train.py), chargé en
# warm start par la boucle nocturne (run_night_optimization) à chaque nuit.
PCB_WORLD_MODEL_NPZ=data/trained_models/world_model_torch.npz

# --- simulateur C++/CUDA ---
ENABLE_CUDA=false
# GPU pour Ollama (optionnel) : docker compose -f docker-compose.yml \
#   -f docker-compose.gpu.yml up -d ollama

# --- latences cibles (section 11) ---
WS_TARGET_LATENCY_MS=100
BUS_TARGET_LATENCY_MS=50
FAST_EVAL_BUDGET_S=5.0

# --- crédits (brique DeepPCB) ---
CREDITS_LEDGER_PATH=data/projects/credits.json

# --- sécurité gateway ---
JWT_SECRET=change-me-in-production
JWT_EXPIRES_MIN=120
API_RATE_LIMIT_DEFAULT=60/minute

# --- mode distribué optionnel (orchestrator) ---
# 1 = appels gRPC réels via les stubs générés (make proto) ; 0 = in-process
ORCH_DISTRIBUTED=0

# --- benchmark vs Quilter : endpoint réel (optionnel) ---
# Définis (+ clé), le client bascule du stub déterministe vers l'appel httpx
# authentifié et persiste chaque replay dans data/projects/<id>/quilter_replay.json
QUILTER_ENDPOINT=
QUILTER_API_KEY=
